{
  "name": "webpipe-sdk",
  "version": "0.1.0",
  "description": "Official TypeScript/JavaScript SDK for WebPipe.ai — turn any webpage into clean, structured data",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=18"
  },
  "keywords": ["webpipe", "scraping", "crawler", "markdown", "llm", "data-extraction"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
